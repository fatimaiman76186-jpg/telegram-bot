# Required: get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Optional: lets Claude pick the best moments (much better than the keyword fallback)
ANTHROPIC_API_KEY=

# Optional: restrict the bot to specific Telegram user IDs, comma-separated
ALLOWED_USER_IDS=

# Optional tuning
WHISPER_MODEL=small
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=59
MAX_CLIPS=5

# Optional: local Telegram Bot API server for files >20MB (e.g. http://localhost:8081)
TELEGRAM_LOCAL_API_URL=
